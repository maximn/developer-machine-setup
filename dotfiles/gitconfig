# Included at the top of ~/.gitconfig by setup.sh, so anything you set in
# ~/.gitconfig itself (name, email, signing, overrides) wins.

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true          # push annotated tags along with the commits
[fetch]
	prune = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram      # clearer diffs when code moves around
[rebase]
	autoStash = true           # rebase with uncommitted changes
	updateRefs = true          # keep stacked branches in sync when rebasing
[commit]
	verbose = true             # show the diff while writing the commit message
[branch]
	sort = -committerdate      # git branch: most recent first
[tag]
	sort = version:refname     # git tag: v1.10 after v1.9
[column]
	ui = auto                  # list branches and tags in columns
[help]
	autocorrect = prompt       # offer to run the command you meant on a typo

# Readable diffs (git-delta)
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
