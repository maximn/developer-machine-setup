# Loaded from your Ghostty config by setup.sh (config-file = ...). Ghostty
# reads included files last, so these settings override your own config.
# To override them in turn, put your settings in config.local next to your
# Ghostty config: setup.sh loads it after this file.

# Cmd+K: send Ctrl+L instead of Ghostty's own clear_screen. Ghostty skips
# clear_screen while a full-screen app (herdr, tmux) is running and sends the
# key on as an escape code, which shows up in the shell as "7;9u".
keybind = super+k=text:\x0c

# Left Option sends Alt, so terminal apps like herdr receive alt+<key>.
# Right Option still types special characters (€, ñ, ∞).
macos-option-as-alt = left

# Ask before a program sets the clipboard (OSC 52). Anything printed to the
# terminal can carry the sequence -- a directory name in the prompt, a file
# you cat -- so it should not be able to replace what you paste next.
clipboard-write = ask
